# Copy to hub.env and replace every example value. The local file is ignored.
APPROVAL_ORIGIN=https://approve.example.com
APPROVAL_RP_ID=approve.example.com
VAPID_SUBJECT=mailto:admin@example.com
SPOKE_TOKEN_SPEC=spoke=/var/lib/sudo-hub/client-token-spoke
# Use lxc:VMID for a container or qemu:VMID for a Linux VM with QEMU Guest Agent.
SPOKE_TARGET_SPEC=spoke=lxc:123
