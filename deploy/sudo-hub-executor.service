[Unit]
Description=Sudo Hub passkey-authorized root executor
After=local-fs.target
ConditionPathExists=/etc/sudo-hub/credential.json

[Service]
Type=simple
EnvironmentFile=/etc/sudo-hub/hub.env
ExecStart=/opt/sudo-hub/.venv/bin/sudo-hub-executor --allowed-user sudo-hub --origin ${APPROVAL_ORIGIN} --rp-id ${APPROVAL_RP_ID} --guest-target ${SPOKE_TARGET_SPEC}
Restart=on-failure
RestartSec=2
UMask=0077
RuntimeDirectory=sudo-hub
RuntimeDirectoryMode=0755
StateDirectory=sudo-hub-executor
StateDirectoryMode=0700
LogsDirectory=sudo-hub
LogsDirectoryMode=0700
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
# Package and kernel maintenance needs read access to /usr/lib/modules.
# The executor still cannot load arbitrary modules unless an approved command
# explicitly does so.
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
